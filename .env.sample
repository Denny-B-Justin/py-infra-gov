# =============================================================================
# InfraGov Assessment Tool — environment variables
#
# LOCAL: copy to `.env` (git-ignored) and fill in.
# POSIT CONNECT: do NOT upload a .env file. Set each variable in the content's
#   Settings → Vars panel (tick "secret" for every credential). Values set
#   there are encrypted at rest by Connect and never exposed to viewers.
# Generate keys with:  python manage.py gen-keys
# =============================================================================

# ---- Application ------------------------------------------------------------
# production | development  (production refuses to start without secure config)
APP_ENV=production
# Never "true" in production — ignored unless APP_ENV=development.
DASH_DEBUG=false
# Public URL of the deployed content (used in reset/invite links + CSRF origin check)
APP_BASE_URL=https://connect.example.org/content/00000000-0000-0000-0000-000000000000/
# Extra origins allowed to POST (comma separated). Leave EMPTY = same-origin only.
ALLOWED_ORIGINS=

# [SECRET] Flask session signing key — ≥ 32 random characters
SECRET_KEY=change-me-run-python-manage.py-gen-keys
# [SECRET] AES-256-GCM key for field-level encryption (urlsafe base64 of 32 bytes).
# Losing it makes encrypted columns unreadable — store it in your key vault.
FIELD_ENCRYPTION_KEY=change-me-run-python-manage.py-gen-keys

# Session lifetime
SESSION_IDLE_TIMEOUT_MIN=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ---- Database: Azure Databricks Unity Catalog (prd_mega.sgpbpi163) ----------
DB_BACKEND=databricks
# Workspace host WITHOUT https://, e.g. adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
# SQL warehouse → Connection details → HTTP path
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
# [SECRET] Service principal credentials
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_CLIENT_SECRET=change-me
# databricks-oauth     → secret created in Databricks (Account console → Service principal → Secrets)
# azure-client-secret  → Microsoft Entra ID app-registration secret (also set AZURE_TENANT_ID)
DATABRICKS_AUTH_TYPE=databricks-oauth
AZURE_TENANT_ID=

# Local development only (DB_BACKEND=sqlite, APP_ENV=development)
# SQLITE_PATH=.local/infragov.sqlite3
# LOCAL_STORAGE_DIR=.local/documents

# ---- Optional: AI features (AI Cleanup / Suggest Responses) ----------------
# [SECRET] Leave empty to hide the AI buttons.
ANTHROPIC_API_KEY=
AI_REFINE_MODEL=claude-haiku-4-5-20251001
AI_SUGGEST_MODEL=claude-sonnet-5-5

# ---- Optional: outbound e-mail for password resets / invitations -----------
# Without SMTP, admins get one-time links to share manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# [SECRET]
SMTP_PASSWORD=
SMTP_FROM=InfraGov Assessment Tool <no-reply@pim-pam.net>

# ---- Migration only (migration/migrate_supabase_to_uc.py — NOT needed on Connect)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
